{
  "appid": "your-app-id",
  "compileType": "miniprogram",
  "miniprogramRoot": "miniprogram/",
  "cloudfunctionRoot": "cloudfunctions/",
  "setting": {
    "es6": true,
    "enhance": true,
    "postcss": true,
    "minified": true,
    "uploadWithSourceMap": true
  },
  "packOptions": {
    "ignore": [
      { "type": "glob", "value": "node_modules/**/*" },
      { "type": "glob", "value": "ci/**/*" },
      { "type": "glob", "value": "private.*.key" }
    ]
  },
  "editorSetting": {
    "tabIndent": "insertSpaces",
    "tabSize": 2
  }
}
