.page { background: #f5f5f5; min-height: 100vh; padding: 24rpx; }
.form { background: #fff; border-radius: 16rpx; padding: 0 24rpx; }
.field { display: flex; align-items: center; padding: 28rpx 0; border-bottom: 1rpx solid #f0f0f0; }
.field:last-child { border-bottom: none; }
.label { width: 160rpx; font-size: 28rpx; color: #333; flex-shrink: 0; }
.label.required::after { content: ' *'; color: #f44336; }
.readonly { flex: 1; font-size: 28rpx; color: #999; }
.input { flex: 1; font-size: 28rpx; color: #333; }
.picker-val { flex: 1; font-size: 28rpx; color: #333; }
.picker-val.placeholder { color: #bbb; }
.submit-btn { margin-top: 40rpx; background: #1976d2; color: #fff; border-radius: 12rpx; font-size: 32rpx; border: none; }
