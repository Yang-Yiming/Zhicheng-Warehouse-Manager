<view class="page">
  <view class="form">
    <view class="field">
      <text class="label">操作人</text>
      <text class="readonly">{{operatorName}}</text>
    </view>

    <view class="field">
      <text class="label required">操作类型</text>
      <picker mode="selector" range="{{OPERATIONS}}" value="{{operationIndex}}" bindchange="onOperationChange">
        <view class="picker-val {{form.operation ? '' : 'placeholder'}}">{{form.operation || '请选择'}}</view>
      </picker>
    </view>

    <view class="field">
      <text class="label required">物资编号</text>
      <view wx:if="{{locked}}"><text class="readonly">{{form.itemId}}</text></view>
      <input wx:else class="input" placeholder="如 A1-3-05" value="{{form.itemId}}" bindinput="onItemIdInput" />
    </view>

    <view class="field">
      <text class="label required">物品名称</text>
      <input class="input" placeholder="如 折叠桌" value="{{form.itemName}}" bindinput="onItemNameInput" />
    </view>

    <view class="field">
      <text class="label required">所属组织</text>
      <view wx:if="{{locked}}"><text class="readonly">{{form.organization}}</text></view>
      <picker wx:else mode="selector" range="{{organizations}}" value="{{orgIndex}}" bindchange="onOrgChange">
        <view class="picker-val {{form.organization ? '' : 'placeholder'}}">{{form.organization || '请选择'}}</view>
      </picker>
    </view>

    <view class="field">
      <text class="label required">物品数量</text>
      <input class="input" type="number" placeholder="正整数" value="{{form.quantity}}" bindinput="onQuantityInput" />
    </view>

    <view class="field">
      <text class="label required">操作日期</text>
      <picker mode="date" value="{{dateValue}}" bindchange="onDateChange">
        <view class="picker-val">{{dateValue}}</view>
      </picker>
    </view>

    <view class="field">
      <text class="label required">操作时间</text>
      <picker mode="time" value="{{timeValue}}" bindchange="onTimeChange">
        <view class="picker-val">{{timeValue}}</view>
      </picker>
    </view>
  </view>

  <button class="submit-btn" bindtap="onSubmit" loading="{{submitting}}" disabled="{{submitting}}">提交</button>
</view>
