<view class="page">
  <!-- 操作类型分段选择器 -->
  <view class="card seg-card">
    <view class="seg-group">
      <view class="seg-item seg-in {{form.operation === '入库' ? 'active' : ''}}" bindtap="onSelectOperation" data-op="入库">
        <text class="seg-icon">↓</text>
        <text class="seg-label">入库</text>
      </view>
      <view class="seg-item seg-out {{form.operation === '出库' ? 'active' : ''}}" bindtap="onSelectOperation" data-op="出库">
        <text class="seg-icon">↑</text>
        <text class="seg-label">出库</text>
      </view>
    </view>
  </view>

  <!-- 信息卡片 -->
  <view class="card">
    <view class="field">
      <text class="label">操作人</text>
      <text class="readonly">{{operatorName}}</text>
    </view>
    <view class="field no-border">
      <text class="label required">所属组织</text>
      <view wx:if="{{locked}}" class="field-val"><text class="readonly">{{form.organization}}</text></view>
      <picker wx:else class="picker-wrap" mode="selector" range="{{organizations}}" value="{{orgIndex}}" bindchange="onOrgChange">
        <view class="picker-row">
          <text class="picker-val {{form.organization ? '' : 'placeholder'}}">{{form.organization || '请选择'}}</text>
          <text class="arrow">›</text>
        </view>
      </picker>
    </view>
  </view>

  <!-- 物资卡片 -->
  <view class="card">
    <view class="field">
      <text class="label required">物资编号</text>
      <view wx:if="{{locked}}" class="field-val"><text class="readonly">{{form.itemId}}</text></view>
      <input wx:else class="input" placeholder="如 A1-3-05" value="{{form.itemId}}" bindinput="onItemIdInput" bindblur="onItemIdBlur" />
    </view>
    <view wx:if="{{form.operation === '出库' && itemIdError}}" class="field-error">{{itemIdError}}</view>
    <view class="field no-border">
      <text class="label required">物品名称</text>
      <input class="input {{(form.operation === '出库' || itemFound) ? 'input-disabled' : ''}}" placeholder="如 折叠桌" value="{{form.itemName}}" bindinput="onItemNameInput" disabled="{{locked || form.operation === '出库' || itemFound}}" />
    </view>
  </view>

  <!-- 数量卡片 -->
  <view class="card">
    <view class="field no-border">
      <text class="label required">物品数量</text>
      <view class="stepper">
        <view class="stepper-btn stepper-edge {{form.quantity <= 1 ? 'disabled' : ''}}" bindtap="onQuantityMin">min</view>
        <view class="stepper-btn {{form.quantity <= 1 ? 'disabled' : ''}}" bindtap="onQuantityStep" data-delta="-1">−</view>
        <input class="stepper-input" type="number" value="{{form.quantity}}" bindinput="onQuantityInput" />
        <view class="stepper-btn" bindtap="onQuantityStep" data-delta="1">+</view>
        <view class="stepper-btn stepper-edge {{form.operation !== '出库' || maxQuantity === null ? 'disabled' : ''}}" bindtap="onQuantityMax">max</view>
      </view>
    </view>
  </view>

  <!-- 时间卡片 -->
  <view class="card">
    <view class="field">
      <text class="label required">操作日期</text>
      <picker class="picker-wrap" mode="date" value="{{dateValue}}" bindchange="onDateChange">
        <view class="picker-row">
          <text class="picker-val">{{dateValue}}</text>
          <text class="arrow">›</text>
        </view>
      </picker>
    </view>
    <view class="field no-border">
      <text class="label required">操作时间</text>
      <picker class="picker-wrap" mode="time" value="{{timeValue}}" bindchange="onTimeChange">
        <view class="picker-row">
          <text class="picker-val">{{timeValue}}</text>
          <text class="arrow">›</text>
        </view>
      </picker>
    </view>
  </view>

  <button class="submit-btn {{form.operation === '出库' ? 'btn-out' : 'btn-in'}}" bindtap="onSubmit" loading="{{submitting}}" disabled="{{submitting || (form.operation === '出库' && !itemFound)}}">提交</button>
</view>
