<view class="page">
  <view class="search-bar">
    <input class="search-input" placeholder="搜索物资、组织..." value="{{searchText}}" bindinput="onSearch" />
  </view>

  <view class="list">
    <block wx:for="{{filtered}}" wx:key="_id">
      <view class="card" bindtap="onItemTap" data-item="{{item}}">
        <view class="card-row main-row">
          <text class="item-name">{{item.itemName}}</text>
          <view class="qty-badge"><text class="qty-num">{{item.quantity}}</text><text class="qty-unit">件</text></view>
        </view>
        <view class="card-row sub-row">
          <text class="sub">{{item.itemId}}</text>
          <text class="sep">·</text>
          <text class="sub">{{item.organization}}</text>
        </view>
        <view class="card-row sub-row">
          <text class="sub muted">{{item.lastOperation}} · {{item.lastOperator}} · {{item.lastOperationTime}}</text>
        </view>
        <view wx:if="{{item.notes}}" class="card-row">
          <text class="sub muted">备注: {{item.notes}}</text>
        </view>
      </view>
    </block>

    <view wx:if="{{loading}}" class="tip">加载中...</view>
    <view wx:elif="{{!hasMore && filtered.length > 0}}" class="tip">已加载全部</view>
    <view wx:elif="{{filtered.length === 0 && !loading}}" class="tip">暂无库存</view>
  </view>

  <view class="fab" bindtap="onAddNew">＋</view>
</view>
