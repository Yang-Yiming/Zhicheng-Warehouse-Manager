<view class="page">
  <view class="search-bar">
    <input class="search-input" placeholder="搜索物资、组织、操作人..." value="{{searchText}}" bindinput="onSearch" />
  </view>

  <view class="list">
    <block wx:for="{{filtered}}" wx:key="_id">
      <view class="card">
        <view class="card-row main-row">
          <text class="item-name">{{item.itemName}}</text>
          <text class="op-tag op-{{item.opClass}}">{{item.operation}}</text>
          <text class="qty">×{{item.quantity}}</text>
        </view>
        <view class="card-row sub-row">
          <text class="sub">{{item.itemId}}</text>
          <text class="sep">·</text>
          <text class="sub">{{item.organization}}</text>
          <text class="sep">·</text>
          <text class="sub">{{item.operationTime}}</text>
        </view>
        <view class="card-row sub-row">
          <text class="sub muted">操作人: {{item.operator}}</text>
        </view>
      </view>
    </block>

    <view wx:if="{{loading}}" class="tip">加载中...</view>
    <view wx:elif="{{!hasMore && filtered.length > 0}}" class="tip">已加载全部</view>
    <view wx:elif="{{filtered.length === 0 && !loading}}" class="tip">暂无记录</view>
  </view>

  <view class="fab" bindtap="onAddNew">＋</view>
</view>
