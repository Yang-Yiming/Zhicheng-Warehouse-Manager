<view class="page">
  <view class="section-title">我的信息</view>
  <view class="card">
    <view class="field">
      <text class="label">昵称</text>
      <block wx:if="{{editingName}}">
        <input class="input" value="{{nameInput}}" bindinput="onNameInput" focus="{{true}}" />
        <text class="action-btn" bindtap="onSaveName">保存</text>
        <text class="action-btn cancel" bindtap="onCancelEdit">取消</text>
      </block>
      <block wx:else>
        <text class="value">{{displayName}}</text>
        <text class="action-btn" bindtap="onEditName">编辑</text>
      </block>
    </view>
  </view>

  <view class="section-title">所属组织</view>
  <view class="card">
    <view class="tag-list">
      <view wx:for="{{userOrgs}}" wx:key="*this" class="tag">
        <text>{{item}}</text>
        <text class="tag-del" bindtap="onRemoveUserOrg" data-idx="{{index}}">×</text>
      </view>
    </view>
    <picker wx:if="{{availableOrgs.length > 0}}" range="{{availableOrgs}}" bindchange="onAddUserOrg">
      <text class="action-btn">+ 添加</text>
    </picker>
    <text wx:else class="empty-hint">已加入全部组织</text>
  </view>

  <view class="section-title">全部组织</view>
  <view class="card">
    <view class="field">
      <text class="value">共{{config.organizations.length}}个</text>
      <text wx:if="{{!editingOrgs}}" class="action-btn" bindtap="onEditOrgs">编辑</text>
      <text wx:else class="action-btn" bindtap="onDoneOrgs">完成</text>
    </view>
    <block wx:if="{{editingOrgs}}">
      <view class="tag-list">
        <view wx:for="{{config.organizations}}" wx:key="*this" class="tag">
          <text>{{item}}</text>
          <text class="tag-del" bindtap="onRemoveOrg" data-idx="{{index}}">×</text>
        </view>
      </view>
      <view class="add-row">
        <input class="input" placeholder="添加组织" value="{{newOrg}}" bindinput="onNewOrgInput" confirm-type="done" bindconfirm="onAddOrg" />
        <text class="action-btn" bindtap="onAddOrg">添加</text>
      </view>
    </block>
  </view>
</view>
