.page { background: #f5f5f5; min-height: 100vh; padding: 24rpx; }
.section-title { font-size: 26rpx; color: #999; padding: 16rpx 8rpx 8rpx; }
.card { background: #fff; border-radius: 16rpx; padding: 0 24rpx; margin-bottom: 16rpx; }
.field { display: flex; align-items: center; padding: 28rpx 0; }
.label { width: 120rpx; font-size: 28rpx; color: #333; flex-shrink: 0; }
.value { flex: 1; font-size: 28rpx; color: #333; }
.input { flex: 1; font-size: 28rpx; color: #333; }
.action-btn { font-size: 28rpx; color: #1976d2; padding-left: 20rpx; flex-shrink: 0; }
.action-btn.cancel { color: #999; }
.tag-list { display: flex; flex-wrap: wrap; gap: 16rpx; padding: 24rpx 0 8rpx; min-height: 40rpx; }
.tag { display: flex; align-items: center; background: #e3f2fd; border-radius: 32rpx; padding: 8rpx 20rpx; font-size: 26rpx; color: #1565c0; gap: 10rpx; }
.tag-del { color: #90a4ae; font-size: 30rpx; line-height: 1; }
.add-row { display: flex; align-items: center; padding: 16rpx 0 24rpx; border-top: 1rpx solid #f0f0f0; margin-top: 8rpx; }
.empty-hint { font-size: 26rpx; color: #bbb; }
.empty-hint.pad { padding: 24rpx 0; display: block; }
.role-badge { display: inline-flex; align-items: center; padding: 6rpx 20rpx; border-radius: 24rpx; font-size: 24rpx; }
.role-unverified { background: #f5f5f5; color: #999; }
.role-normal { background: #e3f2fd; color: #1565c0; }
.role-admin { background: #e8f5e9; color: #2e7d32; }
.role-superadmin {
  background: linear-gradient(90deg, #ff0000, #ff7700, #ffee00, #00cc44, #0088ff, #aa00ff, #ff0088, #ff0000);
  background-size: 400% 100%;
  color: #fff;
  font-weight: bold;
  text-shadow: 0 1rpx 4rpx rgba(0,0,0,0.35);
  animation: superadmin-flow 2s linear infinite, superadmin-glow 0.8s ease-in-out infinite alternate;
}
@keyframes superadmin-flow {
  0%   { background-position: 0% 50%; }
  100% { background-position: 100% 50%; }
}
@keyframes superadmin-glow {
  0%   { box-shadow: 0 0 6rpx 2rpx rgba(255,100,0,0.5); transform: scale(1); }
  100% { box-shadow: 0 0 18rpx 6rpx rgba(180,0,255,0.7); transform: scale(1.08); }
}
.role-chairman { background: #fce4ec; color: #880e4f; }
.user-row { display: flex; align-items: center; padding: 20rpx 0; border-bottom: 1rpx solid #f0f0f0; }
.user-row:last-child { border-bottom: none; }
.user-info { flex: 1; min-width: 0; }
.user-name { font-size: 28rpx; color: #333; display: block; }
.user-orgs { font-size: 22rpx; color: #999; display: block; margin-top: 4rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.user-actions { display: flex; gap: 12rpx; flex-shrink: 0; margin-left: 16rpx; }
.user-btn { font-size: 24rpx; padding: 8rpx 18rpx; border-radius: 8rpx; }
.user-btn.approve { color: #fff; background: #4caf50; }
.user-btn.dismiss { color: #666; background: #f0f0f0; }
.user-btn.edit { color: #1976d2; background: #e3f2fd; }
.user-btn.promote { color: #fff; background: #ff9800; }
.user-btn.demote { color: #fff; background: #f44336; }
.user-btn.transfer { color: #fff; background: #9c27b0; }

