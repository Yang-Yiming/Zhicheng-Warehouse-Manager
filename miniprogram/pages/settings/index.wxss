.page { background: #f5f5f5; min-height: 100vh; padding: 24rpx; }
.section-title { font-size: 26rpx; color: #999; padding: 16rpx 8rpx 8rpx; }
.card { background: #fff; border-radius: 16rpx; padding: 0 24rpx; margin-bottom: 16rpx; }
.field { display: flex; align-items: center; padding: 28rpx 0; }
.label { width: 120rpx; font-size: 28rpx; color: #333; flex-shrink: 0; }
.value { flex: 1; font-size: 28rpx; color: #333; }
.input { flex: 1; font-size: 28rpx; color: #333; }
.action-btn { font-size: 28rpx; color: #1976d2; padding-left: 20rpx; flex-shrink: 0; }
.action-btn.cancel { color: #999; }
.tag-list { display: flex; flex-wrap: wrap; gap: 16rpx; padding: 24rpx 0 8rpx; min-height: 40rpx; }
.tag { display: flex; align-items: center; background: #e3f2fd; border-radius: 32rpx; padding: 8rpx 20rpx; font-size: 26rpx; color: #1565c0; gap: 10rpx; }
.tag-del { color: #90a4ae; font-size: 30rpx; line-height: 1; }
.add-row { display: flex; align-items: center; padding: 16rpx 0 24rpx; border-top: 1rpx solid #f0f0f0; margin-top: 8rpx; }
.empty-hint { font-size: 26rpx; color: #bbb; }
