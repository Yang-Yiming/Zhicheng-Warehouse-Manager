<view class="page">
  <view class="section-title">{{targetName}} 的所属组织</view>
  <view class="card">
    <view class="tag-list">
      <view wx:for="{{userOrgs}}" wx:key="*this" class="tag">
        <text>{{item}}</text>
        <text class="tag-del" bindtap="onRemoveOrg" data-idx="{{index}}">×</text>
      </view>
    </view>
    <picker wx:if="{{availableOrgs.length > 0}}" range="{{availableOrgs}}" bindchange="onAddOrg">
      <text class="action-btn">+ 添加</text>
    </picker>
    <text wx:else class="empty-hint">已加入全部组织</text>
  </view>

  <view class="save-btn-wrap">
    <button class="save-btn" bindtap="onSave" disabled="{{saving}}">
      {{saving ? '保存中...' : '保存'}}
    </button>
  </view>
</view>
