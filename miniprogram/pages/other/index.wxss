.page { background: #f5f5f5; min-height: 100vh; padding: 24rpx; }
.card { background: #fff; border-radius: 16rpx; padding: 28rpx 24rpx; }
.h1 { display: block; font-size: 38rpx; color: #222; font-weight: 600; margin: 8rpx 0 20rpx; }
.line { display: block; font-size: 36rpx; color: #333; line-height: 1.6; }
.line-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; }
.copy-btn { width: 56rpx; height: 56rpx; display: flex; align-items: center; justify-content: center; flex-shrink: 0; margin-top: 8rpx; }
.copy-icon { width: 34rpx; height: 34rpx; position: relative; }
.copy-square { position: absolute; width: 20rpx; height: 20rpx; border: 3rpx solid #8f8f8f; border-radius: 4rpx; background: #fff; }
.copy-square.back { top: 0; left: 0; }
.copy-square.front { top: 8rpx; left: 8rpx; }
